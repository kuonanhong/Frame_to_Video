{
  "name": "frame-studio",
  "version": "5.0.0",
  "description": "Storyboard editor with optional local CPU expert model workers and SSH incremental deployment",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "npm run build:story",
    "test": "node tests/ui-smoke.cjs",
    "test:providers": "node tests/provider-contract.mjs",
    "build:cpu": "node edge/model/build-detector.mjs && node tools/build-cpu.mjs",
    "test:cpu": "node --test edge/tests/motion-core.test.mjs",
    "test:cpu:browser": "node edge/tests/browser-smoke.cjs",
    "build:story": "node tools/build-story-app.mjs && node tools/build-story.mjs",
    "test:story": "node --test story/tests/media.test.mjs",
    "build:legacy": "node tools/build.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@gradio/client": "1.19.0",
    "@tensorflow-models/coco-ssd": "2.2.3",
    "@tensorflow/tfjs-backend-cpu": "4.22.0",
    "@tensorflow/tfjs-converter": "4.22.0",
    "@tensorflow/tfjs-core": "4.22.0",
    "esbuild": "0.25.10"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
